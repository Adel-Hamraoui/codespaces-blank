# ============================================================================
# Variables d'environnement — GAM CLEAN
# Copiez ce fichier en `.env.local` pour le développement local.
# Sur Vercel : Project → Settings → Environment Variables.
# NE COMMITEZ JAMAIS de vraie clé dans le dépôt.
# ============================================================================

# URL publique du site (domaine de production, sans slash final).
# Utilisée pour le canonical, le sitemap, Open Graph et les données structurées.
# Si absente sur Vercel, l'URL de production Vercel est utilisée automatiquement.
NEXT_PUBLIC_SITE_URL=https://www.exemple-gamclean.fr

# --- Formulaires (devis + contact) : envoi par e-mail via Resend -------------
# Clé API Resend (https://resend.com → API Keys). SECRET : serveur uniquement.
RESEND_API_KEY=

# Adresse qui reçoit les demandes (boîte de GAM CLEAN).
CONTACT_TO_EMAIL=contact.gmaclean@gmail.com

# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, gardez
# "GAM CLEAN <onboarding@resend.dev>" : Resend ne livrera alors QU'À l'adresse
# du compte Resend. Après vérification d'un domaine : "GAM CLEAN <devis@votre-domaine.fr>".
CONTACT_FROM_EMAIL=GAM CLEAN <onboarding@resend.dev>

# Envoyer un accusé de réception au prospect (nécessite un domaine vérifié).
SEND_CUSTOMER_CONFIRMATION=false

# Développement uniquement : "log" affiche les demandes dans le terminal au lieu
# de les envoyer. Ignoré en production.
CONTACT_DELIVERY_MODE=

# --- Mesure d'audience (optionnelle, sans cookie) ----------------------------
# Valeurs possibles : vide (aucune mesure), "vercel" (Vercel Web Analytics),
# "plausible" (Plausible Analytics).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Pour Plausible uniquement : domaine déclaré dans Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
