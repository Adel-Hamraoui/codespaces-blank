# ============================================================================
# Variables d'environnement — GAM CLEAN
# Copiez ce fichier en `.env.local` pour le développement local.
# Sur Vercel : Project → Settings → Environment Variables.
# NE COMMITEZ JAMAIS de vraie valeur secrète dans le dépôt.
# ============================================================================

# URL publique du site (domaine de production, sans slash final).
# Utilisée pour le canonical, le sitemap, Open Graph, les données structurées
# et les liens envoyés par e-mail (back-office, invitations à laisser un avis).
# Si absente sur Vercel, l'URL de production Vercel est utilisée automatiquement.
NEXT_PUBLIC_SITE_URL=https://www.exemple-gamclean.fr

# --- Base de données (Supabase PostgreSQL) -----------------------------------
# SECRET. Chaîne de connexion utilisée par le site sur Vercel : « Transaction
# pooler » de Supabase (port 6543), adaptée aux fonctions serverless.
# Caractères spéciaux du mot de passe à encoder (ex. @ → %40).
# Sans cette variable, le site public fonctionne avec le contenu par défaut
# (dans le code) et les demandes ne sont transmises que par e-mail ; le
# back-office est alors indisponible.
DATABASE_URL=

# Optionnel. SECRET. Connexion utilisée par `npm run db:migrate` et
# `npm run db:seed` (« Session pooler » ou connexion directe, avec le rôle
# propriétaire). Si absente, DATABASE_URL est utilisée.
DATABASE_URL_MIGRATIONS=

# Nombre maximal de connexions par instance (1 à 20). Gardez une petite valeur
# en serverless : chaque instance Vercel ouvre son propre pool.
DB_POOL_MAX=3

# SECRET. Chaîne aléatoire d'au moins 32 caractères (ex. `openssl rand -base64 48`).
# Sert à rendre irréversibles les empreintes des adresses IP utilisées par l'anti-abus.
APP_SECRET=

# SECRET. Protège la tâche quotidienne de maintenance (/api/cron/maintenance) :
# Vercel l'envoie automatiquement dans l'en-tête Authorization des tâches planifiées.
CRON_SECRET=

# --- E-mails : notification des demandes via Resend -------------------------
# Clé API Resend (https://resend.com → API Keys). SECRET : serveur uniquement.
RESEND_API_KEY=

# Adresse qui reçoit les demandes. Par défaut : l'e-mail saisi dans le back-office.
CONTACT_TO_EMAIL=

# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, gardez
# "GAM CLEAN <onboarding@resend.dev>" : Resend ne livrera alors QU'À l'adresse
# du compte Resend. Après vérification d'un domaine : "GAM CLEAN <devis@votre-domaine.fr>".
CONTACT_FROM_EMAIL=GAM CLEAN <onboarding@resend.dev>

# Envoyer un accusé de réception au prospect (nécessite un domaine vérifié).
SEND_CUSTOMER_CONFIRMATION=false

# Développement uniquement : "log" affiche les e-mails dans le terminal au lieu
# de les envoyer. Ignoré en production.
CONTACT_DELIVERY_MODE=

# --- Mesure d'audience (optionnelle, sans cookie) ----------------------------
# Valeurs possibles : vide (aucune mesure), "vercel" (Vercel Web Analytics),
# "plausible" (Plausible Analytics).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Pour Plausible uniquement : domaine déclaré dans Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Tests (machine de développement uniquement, jamais sur Vercel) ----------
# Bases PostgreSQL DÉDIÉES aux tests : elles sont vidées à chaque lancement.
# Par sécurité, leur nom doit se terminer par _test (TEST, BENCH) ou _e2e (E2E).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/gam_test
# BENCH_DATABASE_URL=postgres://postgres@127.0.0.1:5432/gam_test
# E2E_DATABASE_URL=postgres://postgres@127.0.0.1:5432/gam_e2e
