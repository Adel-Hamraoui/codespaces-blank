{
  "name": "gam-clean-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "test": "tsx --conditions=react-server --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "test:db": "tsx --conditions=react-server --test --test-reporter=spec --test-concurrency=1 \"tests/db/**/*.test.ts\"",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "e2e:prepare": "tsx --conditions=react-server scripts/e2e-prepare.ts",
    "test:e2e": "playwright test",
    "db:benchmark": "tsx --conditions=react-server scripts/db-benchmark.ts"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
